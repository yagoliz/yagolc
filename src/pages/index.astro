---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const latestPost = (await getCollection("blog"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const latestPub = (await getCollection("publications"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const socialLinks = [
    {
        label: "Google Scholar",
        href: "https://scholar.google.com/citations?hl=en&user=7IsJtboAAAAJ",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>`,
    },
    {
        label: "GitHub",
        href: "https://github.com/yagoliz",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>`,
    },
    {
        label: "Bluesky",
        href: "https://bsky.app/profile/yagolc.bsky.social",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.6 3.476 6.152 3.228-4.346.426-8.143 2.189-4.346 7.686 4.532 5.102 7.254-1.972 9.57-5.478 2.316 3.506 4.07 10.095 9.57 5.478 3.797-5.497 0-7.26-4.346-7.686 2.552.248 5.367-.6 6.152-3.228C23.622 9.418 24 4.458 24 3.768c0-.69-.139-1.861-.902-2.203-.659-.3-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/></svg>`,
    },
    {
        label: "LinkedIn",
        href: "https://linkedin.com/in/yagoliz",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    },
];
---

<Base title="Yago Lizarribar">
    <section class="hero">
        <div>
            <h1>Hi, I'm Yago.</h1>
            <p class="subtitle">Data Scientist & Researcher</p>
            <p class="bio">
                I am a researcher and data scientist with diverse toolsets in my
                belt: robotics, signal processing, wireless communications, and
                even physiology. I have a background in mechatronics and
                telecommunications engineering. My works include building
                autonomous bicycles, building RF signal localization
                infrastructure, and physical health monitoring in intense
                activities. I am currently working as a Scientific Project
                Manager at the <a href="https://www.cydcampus.admin.ch/en"
                    >CYD Campus</a
                > in Bern, Switzerland.
            </p>
            <div class="social-links">
                {
                    socialLinks.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={link.label}
                        >
                            <Fragment set:html={link.icon} />
                        </a>
                    ))
                }
            </div>
        </div>
        <img src="/images/me.jpg" alt="Yago Lizarribar" class="avatar" />
    </section>

    <div class="latest-sections">
        {latestPost && (
            <section class="latest-section">
                <h2>Latest Post</h2>
                <a href={`/blog/${latestPost.id}`} class="latest-card">
                    <span class="latest-title">{latestPost.data.title}</span>
                    <time datetime={latestPost.data.date.toISOString()}>
                        {latestPost.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                        })}
                    </time>
                    {latestPost.data.description && (
                        <p class="latest-desc">{latestPost.data.description}</p>
                    )}
                </a>
            </section>
        )}

        {latestPub && (
            <section class="latest-section">
                <h2>Latest Publication</h2>
                <a href={`/publications/${latestPub.id}`} class="latest-card">
                    <span class="latest-title">{latestPub.data.title}</span>
                    <span class="latest-authors">{latestPub.data.authors}</span>
                    {latestPub.data.venue && (
                        <span class="latest-venue">{latestPub.data.venue}</span>
                    )}
                    <span class="latest-year">{latestPub.data.date.getFullYear()}</span>
                </a>
            </section>
        )}
    </div>
</Base>

<style>
    .hero {
        display: flex;
        gap: 3rem;
        align-items: center;
        max-width: var(--max-width);
        margin: 0 auto 2rem;
    }

    .hero > div {
        flex: 1;
    }

    .avatar {
        width: 240px;
        height: 240px;
        border-radius: 12px;
        border-color: magenta;
        border: 10px;
        object-fit: cover;
        flex-shrink: 0;
    }

    h1 {
        font-size: 2.5rem;
    }

    .subtitle {
        color: var(--color-text-muted);
        font-size: 1.2rem;
        margin: 0.25rem 0 1.25rem;
    }

    .bio {
        margin-bottom: 1.25rem;
    }

    .social-links {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .social-links a {
        display: flex;
        align-items: center;
        color: var(--color-text-muted);
        transition: color 0.15s;
    }
    .social-links a:hover {
        color: var(--color-accent);
        text-decoration: none;
    }

    .latest-sections {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        max-width: var(--max-width);
        margin: 0 auto;
    }

    .latest-section h2 {
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
        color: var(--color-text-muted);
        font-weight: 500;
    }

    .latest-card {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .latest-card:hover {
        border-color: var(--color-accent);
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        text-decoration: none;
    }

    .latest-title {
        font-weight: 500;
    }

    .latest-card time,
    .latest-year {
        font-size: 0.85rem;
        color: var(--color-text-muted);
    }

    .latest-desc {
        font-size: 0.9rem;
        color: var(--color-text-muted);
        margin-top: 0.25rem;
    }

    .latest-authors {
        font-size: 0.9rem;
        color: var(--color-text-muted);
    }

    .latest-venue {
        font-size: 0.9rem;
        font-style: italic;
        color: var(--color-text-muted);
    }

    @media (max-width: 700px) {
        .hero {
            flex-direction: column-reverse;
            text-align: center;
        }
        .avatar {
            width: 180px;
            height: 180px;
        }
        .social-links {
            justify-content: center;
        }
    }
</style>
