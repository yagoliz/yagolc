---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const pubs = await getCollection("publications");
  return pubs.map((pub) => ({ params: { id: pub.id }, props: { pub } }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
---

<Base title={`${pub.data.title} — Yago Lizarribar`}>
  <article class="narrow">
    <header>
      <h1>{pub.data.title}</h1>
      <span class="authors">{pub.data.authors}</span>
      {pub.data.venue && <span class="venue">{pub.data.venue}</span>}
      <div class="meta">
        <time datetime={pub.data.date.toISOString()}>
          {pub.data.date.getFullYear()}
        </time>
        {pub.data.doi && (
          <a
            href={`https://doi.org/${pub.data.doi}`}
            target="_blank"
            rel="noopener noreferrer"
            class="doi"
          >
            DOI
          </a>
        )}
        {pub.data.link && (
          <a
            href={pub.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="ext-link"
          >
            Paper ↗
          </a>
        )}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <a href="/publications" class="back">&larr; Back to publications</a>
  </article>
</Base>

<style>
  .narrow {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  .authors {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .venue {
    display: block;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .doi,
  .ext-link {
    font-size: 0.85rem;
  }

  .prose {
    margin-bottom: 3rem;
  }
  .prose :global(p) {
    margin-bottom: 1rem;
  }
  .prose :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.25rem;
  }

  .back {
    font-size: 0.9rem;
  }
</style>
