        &copy; {year} Yago Lizarribar Carrillo — <a
            href="mailto:yago.lizarribar@proton.me">Reach out</a
        >
    </p>
</footer>

<style>
    footer {
        border-top: 1px solid var(--color-border);
        padding: 2rem var(--spacing);
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .contact {
        font-size: 0.9rem;
    }
</style>
